---
import { CONTACT_EMAIL, SOCIALS } from "@/constants";
import IconMail from "@/assets/icons/IconMail.svg";
import IconLinkedin from "@/assets/icons/IconLinkedin.svg";

const linkedin = SOCIALS.find(s => s.name === "LinkedIn")!;
---

<section id="contact" class="border-t border-border py-20 sm:py-28">
  <div class="app-layout">
    <div class="max-w-2xl">
      <h2 class="text-sm font-semibold tracking-widest text-accent uppercase">Contact</h2>
      <p class="mt-6 text-2xl leading-relaxed font-medium sm:text-3xl">
        Contact us to learn more about our technologies, investing, potential partnerships, and
        more information.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a
          href={`mailto:${CONTACT_EMAIL}`}
          class="inline-flex items-center gap-2 rounded-full bg-accent px-7 py-3 font-semibold text-black transition-colors hover:bg-accent-blue hover:text-white"
        >
          <IconMail class="size-5" />
          {CONTACT_EMAIL}
        </a>
        <a
          href={linkedin.href}
          target="_blank"
          rel="noopener noreferrer"
          title={linkedin.linkTitle}
          class="inline-flex items-center gap-2 rounded-full border border-border px-7 py-3 font-semibold transition-colors hover:border-accent hover:text-accent"
        >
          <IconLinkedin class="size-5" />
          LinkedIn
        </a>
      </div>
    </div>
  </div>
</section>
