---
import { CONTACT_EMAIL, SOCIALS } from "@/constants";
import IconMail from "@/assets/icons/IconMail.svg";
import IconLinkedin from "@/assets/icons/IconLinkedin.svg";

const linkedin = SOCIALS.find(s => s.name === "LinkedIn")!;
---

<section id="contact" class="border-t border-border py-20 sm:py-28">
  <div class="app-layout">
    <div class="max-w-3xl">
      <h2 class="text-sm font-semibold tracking-widest text-accent uppercase">Contact</h2>
      <p class="mt-6 text-2xl leading-relaxed font-medium sm:text-3xl lg:text-4xl">
        Contact us to learn more about our technologies, investing, potential partnerships, and
        more information.
      </p>
      <div class="mt-10 flex flex-col items-stretch gap-4 sm:flex-row sm:flex-wrap sm:items-center">
        <a
          href={`mailto:${CONTACT_EMAIL}`}
          class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-accent px-7 py-3 text-base font-semibold break-all text-black transition-colors hover:bg-accent-blue hover:text-white sm:w-auto sm:text-lg"
        >
          <IconMail class="size-5 shrink-0" />
          {CONTACT_EMAIL}
        </a>
        <a
          href={linkedin.href}
          target="_blank"
          rel="noopener noreferrer"
          title={linkedin.linkTitle}
          class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-border px-7 py-3 text-lg font-semibold transition-colors hover:border-accent hover:text-accent sm:w-auto"
        >
          <IconLinkedin class="size-5 shrink-0" />
          LinkedIn
        </a>
      </div>
    </div>
  </div>
</section>
