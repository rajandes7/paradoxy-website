---
import { TEAM } from "@/constants";
---

<section id="team" class="border-t border-border bg-muted/40 py-20 sm:py-28">
  <div class="app-layout">
    <h2 class="text-sm font-semibold tracking-widest text-accent uppercase">Team</h2>
    <div class="mt-10 grid grid-cols-1 gap-10 sm:grid-cols-2 sm:gap-12">
      {
        TEAM.map(member => (
          <a
            href={member.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-6"
            aria-label={`${member.name} on LinkedIn`}
          >
            <img
              src={member.image}
              alt={member.name}
              class="size-32 shrink-0 rounded-full border border-border object-cover transition-colors group-hover:border-accent sm:size-40 lg:size-48"
            />
            <div>
              <h3 class="text-2xl font-semibold transition-colors group-hover:text-accent sm:text-3xl">
                {member.name}
              </h3>
              <p class="text-lg text-foreground/70">{member.title}</p>
              <span class="mt-2 inline-block rounded-full border border-accent/40 px-3 py-1 text-xs font-medium text-accent">
                {member.role}
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
