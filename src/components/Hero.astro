---
---

<section
  id="hero"
  class="relative flex min-h-[calc(100svh-3.75rem)] items-center overflow-hidden bg-black text-white"
>
  <!-- Decorative particle/glow texture, evoking the brand moodboard -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div
      class="absolute -top-32 -right-24 h-72 w-72 rounded-full bg-accent/20 blur-3xl sm:h-[36rem] sm:w-[36rem]"
    >
    </div>
    <div
      class="absolute -bottom-40 -left-16 h-64 w-64 rounded-full bg-accent-blue/20 blur-3xl sm:h-[30rem] sm:w-[30rem]"
    >
    </div>
    <img
      src="/brand/Molecule.svg"
      alt=""
      class="absolute top-1/2 right-[6%] h-[70%] w-auto -translate-y-1/2 rotate-12 opacity-20 sm:opacity-25"
    />
  </div>

  <div class="app-layout relative py-24 sm:py-32">
    <div class="max-w-3xl">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl lg:text-7xl">
        A Path to Decarbonizing Heavy Industry
      </h1>
      <a
        href="#what-we-do"
        class="mt-10 inline-flex items-center gap-2 rounded-full bg-accent px-7 py-3 text-lg font-semibold text-black transition-colors hover:bg-accent-blue hover:text-white"
      >
        Learn More
        <span aria-hidden="true">&#8595;</span>
      </a>
    </div>
  </div>
</section>
