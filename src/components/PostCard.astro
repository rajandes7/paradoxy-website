---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { formatDate } from "@/utils/formatDate";

type Props = {
  post: CollectionEntry<"blog">;
};

const { post } = Astro.props;
const { title, description, author, pubDatetime, heroImage } = post.data;
---

<a
  href={`/blog/${post.id}`}
  class="group block overflow-hidden rounded-2xl border border-border transition-colors hover:border-accent"
>
  {
    heroImage && (
      <div class="aspect-[1200/630] w-full overflow-hidden bg-black">
        {typeof heroImage === "string" ? (
          <img
            src={heroImage}
            alt=""
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        ) : (
          <Image
            src={heroImage}
            alt=""
            width={1200}
            height={630}
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        )}
      </div>
    )
  }
  <div class="p-6">
    <h2 class="text-xl font-semibold transition-colors group-hover:text-accent">{title}</h2>
    <p class="mt-1 text-sm text-foreground/60">
      {formatDate(pubDatetime)} &middot; {author}
    </p>
    <p class="mt-3 text-foreground/80">{description}</p>
  </div>
</a>
