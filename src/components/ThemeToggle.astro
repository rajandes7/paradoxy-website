---
import IconSun from "@/assets/icons/IconSun.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
---

<button
  id="theme-btn"
  class="relative size-9 shrink-0 rounded-full border border-border p-2 transition-colors hover:border-accent hover:text-accent"
  title="Toggle light &amp; dark mode"
  aria-label="Toggle theme"
  aria-live="polite"
>
  <IconSun
    id="icon-sun"
    class="absolute top-1/2 left-1/2 size-5 -translate-1/2 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90"
  />
  <IconMoon
    id="icon-moon"
    class="absolute top-1/2 left-1/2 size-5 -translate-1/2 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0"
  />
</button>

<script>
  // The initial theme is already applied by the blocking inline script in
  // Layout.astro's <head> (before first paint, to avoid a flash). This
  // script only wires up the toggle button and cross-tab/system sync.
  const THEME_KEY = "theme";

  function applyTheme(theme: "light" | "dark") {
    document.documentElement.setAttribute("data-theme", theme);
    document
      .querySelector("#theme-btn")
      ?.setAttribute("aria-label", `Switch to ${theme === "dark" ? "light" : "dark"} mode`);
  }

  document.querySelector("#theme-btn")?.addEventListener("click", () => {
    const next =
      document.documentElement.getAttribute("data-theme") === "dark"
        ? "light"
        : "dark";
    localStorage.setItem(THEME_KEY, next);
    applyTheme(next);
  });

  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", ({ matches }) => {
      if (localStorage.getItem(THEME_KEY)) return; // user has an explicit preference
      applyTheme(matches ? "dark" : "light");
    });
</script>
